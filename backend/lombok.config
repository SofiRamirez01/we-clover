config.stopBubbling = true

# Sin esto, @RequiredArgsConstructor no copia @Lazy al parámetro del constructor generado —
# necesario en EstadoPedidoService/CargaTallesService para romper el ciclo de beans entre esos
# dos servicios (se necesitan mutuamente: uno dispara el recálculo, el otro expone el chequeo
# de talles completos).
lombok.copyableAnnotations += org.springframework.context.annotation.Lazy
